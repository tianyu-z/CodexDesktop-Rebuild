  "migrationStatus": [
    {
      "feature": "会话/流式运行",
      "status": "已接入：原生流式、Stop、继续、恢复；每轮独立进程。"
    },
    {
      "feature": "Slash commands",
      "status": "已接入：动态目录、原生分派、可搜索分类菜单；终端专用命令仍受 headless 限制。"
    },
    {
      "feature": "命令菜单常用项",
      "status": "部分接入：命令入口可搜索、插入并编辑；各管理器完整图形 UI 未迁移。"
    },
    {
      "feature": "原生侧问 /btw",
      "status": "已接入：同一原生进程的侧问，显示在当前会话；无独立浮动面板。"
    },
    {
      "feature": "模型/Thinking/Effort",
      "status": "已接入：动态模型、会话/角色 effort、thinking、output style；快速入口按模型能力显示。"
    },
    {
      "feature": "Ultracode/workflows",
      "status": "未专门迁移；仅保留运行时公开的原生命令，仍受模型/账号门控。"
    },
    {
      "feature": "权限模式",
      "status": "已接入：原生模式与实际 fallback；每角色隔离，运行中不可直接改模式。"
    },
    {
      "feature": "工具审批",
      "status": "已接入：允许一次、原生建议允许当前运行、拒绝反馈；不承诺跨轮规则或配置文件规则编辑。"
    },
    {
      "feature": "Plan/AskUserQuestion",
      "status": "已接入：单选/多选/自由文本、计划正文、修改意见、两种批准模式；无逐段评论编辑器。"
    },
    {
      "feature": "原生用户对话框",
      "status": "未迁移：工具问题以外的付费同意/实验性 dialog 不自动同意。"
    },
    {
      "feature": "权限规则管理",
      "status": "部分接入：原生规则查看与运行级审批建议；新增/删除持久规则管理器未迁移。"
    },
    {
      "feature": "Sandbox 管理",
      "status": "部分接入：原生配置继续生效、状态可查；编辑设置的专用 UI 未迁移。"
    },
    {
      "feature": "Memory/CLAUDE.md",
      "status": "部分接入：原生文件继续读取、可查看记忆列表；记忆 CRUD 管理器未迁移。"
    },
    {
      "feature": "Skills",
      "status": "部分接入：发现、搜索、执行、原生列表；图形启禁/编辑器未迁移。"
    },
    {
      "feature": "Hooks",
      "status": "部分接入：原生 hooks 生效、可阅读列表；增改和策略提示编辑器未迁移。"
    },
    {
      "feature": "MCP",
      "status": "部分接入：工具执行、状态和运行时公开的管理命令；OAuth/form elicitation 管理器未迁移。"
    },
    {
      "feature": "Plugins/marketplaces",
      "status": "部分接入：已配置插件/技能运行、列表与原生 reload；市场图形安装器未迁移。"
    },
    {
      "feature": "Output styles",
      "status": "已接入：原生样式选择并按会话/角色保留；样式创建编辑器未迁移。"
    },
    {
      "feature": "文件/图片/PDF 附件",
      "status": "部分接入：PNG/JPEG/GIF/WebP 原生图像、文件引用；当前 composer 尚无 PDF/document 内容块入口。"
    },
    {
      "feature": "@mentions/编辑器上下文",
      "status": "部分接入：App 的文件/skill 引用；VS Code 选区、终端和浏览器上下文桥未迁移。"
    },
    {
      "feature": "输入体验",
      "status": "部分接入：slash 补全、保留草稿的命令插入、steer/队列撤回；未完整复刻快捷键与大段粘贴交互。"
    },
    {
      "feature": "语音输入",
      "status": "未迁移 Claude 原生语音服务；现有 App 语音组件不是该原生服务。"
    },
    {
      "feature": "工具卡/输出",
      "status": "部分接入：原生流式、Bash 和通用工具卡、父子归属；完整专用 renderer/MCP Apps 未迁移。"
    },
    {
      "feature": "代码 Diff/逐 hunk 接受",
      "status": "未迁移 Claude 的逐 hunk 审批编辑器。"
    },
